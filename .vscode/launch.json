{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run GGBlab Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode-extension"
      ],
      "stopOnEntry": false,
      "outFiles": [
        "${workspaceFolder}/vscode-extension/dist/**/*.js",
        "${workspaceFolder}/vscode-extension/**/*.js"
      ],
      "sourceMaps": true,
      "preLaunchTask": "Build extension (py314)"
    }
  ]
}
