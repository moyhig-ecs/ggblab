#!/usr/bin/env bash
# Start script for Binder/DOCKER to run JupyterLab with requested ServerApp options
set -euo pipefail

: ${PORT:=8888}

# Optional: repository to sync (set REPO_URL to override)
: ${REPO_URL:=https://github.com/moyhig-ecs/ggblab.git}

WORKDIR=/home/jovyan/work

echo "Syncing repository ${REPO_URL} into ${WORKDIR}/ggblab"
if [ -d "${WORKDIR}/ggblab/.git" ]; then
	cd "${WORKDIR}/ggblab"
	git pull --quiet || true
else
	mkdir -p "${WORKDIR}"
	git clone --quiet "${REPO_URL}" "${WORKDIR}/ggblab" || true
fi

echo "Starting JupyterLab on port ${PORT}"
exec jupyter lab --ServerApp.allow_origin='*' --ServerApp.disable_check_xsrf=True --ServerApp.token='' --no-browser --ip=0.0.0.0 --port="${PORT}"
